# AdSDK Agent 环境变量（复制为 .env 后按本机环境调整）
HOST=127.0.0.1
PORT=8000

# SQLite 任务中心；留空时使用 output/state/adsdk-agent.db。
TASK_DATABASE_PATH=

# 通用 ADB 子进程超时（秒）
ADB_TIMEOUT=120
# 已读取的 apktool 专用配置；当前 runner 仍沿用通用子进程超时
APKTOOL_TIMEOUT=1800
STATIC_UNPACK_CACHE_DIR=

# 每个活跃 MitmSession 独占一个端口；设备代理需指向实际分配端口。
# MITM_PORT 继续作为旧配置兼容别名。
MITM_PORT=8080
MITM_PORT_START=8080
MITM_PORT_END=8090
# mitmdump 绑定的网卡。默认 127.0.0.1（仅 host loopback，非仿真器零行为变更）。
# 设为 0.0.0.0 会监听所有主机网络接口（会被同网主机/仿真器访客访问），
# 仅应在受信任的本地测试网络中使用。
# 仿真器访客机 127.0.0.1 是其自身 loopback（非宿主），不应当作模拟器访问宿主机的地址；
# 应把设备代理指向模拟器可访问的宿主机地址，例如本次 MuMu 实测的 QEMU 网关 10.0.2.2:<port>。
MITM_LISTEN_HOST=127.0.0.1
# 模拟器访问宿主机的地址；留空时不修改设备代理。
MITM_DEVICE_PROXY_HOST=
MITM_READY_TIMEOUT_SECONDS=10
MITM_STOP_TIMEOUT_SECONDS=5

# Frida spawn-gating 的 Hook-ready 与停止超时（秒）
FRIDA_READY_TIMEOUT_SECONDS=15
FRIDA_STOP_TIMEOUT_SECONDS=5
FRIDA_SERVER_MANAGEMENT_ENABLED=false
FRIDA_SERVER_LOCAL_PATH=
FRIDA_SERVER_REMOTE_PATH=/data/local/tmp/frida-server
FRIDA_SERVER_START_TIMEOUT_SECONDS=10
FRIDA_SERVER_HANDSHAKE_TIMEOUT_SECONDS=10
FRIDA_SERVER_STOP_ON_TASK_END=false

# APK 输入边界
# 留空时仅允许项目 samples 目录；多个 Windows 绝对目录使用分号分隔。
# 示例：APK_ALLOWED_ROOTS=D:\authorized-apks;E:\review-queue
APK_ALLOWED_ROOTS=
APK_MAX_SIZE_MB=1024
# true 仅放行普通 UNC 路径；Windows 设备路径和扩展长度路径仍会被拒绝。
ALLOW_UNC_APK_PATHS=false

# 设备标识符稳定脱敏密钥
# 请在保存或共享分析产物前替换为私有随机值，并在需要跨运行关联时保持稳定。
REDACTION_HMAC_KEY=change-me-to-a-long-private-random-secret
